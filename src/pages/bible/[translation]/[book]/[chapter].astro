---
import Base from '../../../../layouts/Base.astro';
import TranslationSwitch from '../../../../components/TranslationSwitch.astro';
import CaretLeft from '@phosphor-icons/core/regular/caret-left.svg';
import {
  TRANSLATIONS,
  TRANSLATION_IDS,
  bookHref,
  chapterHref,
  chapterLabel,
  getBooks,
  getChapters,
  mapChapter,
  type Book,
  type Chapter,
  type TranslationId,
} from '../../../../lib/bible';

interface Link { book: Book; c: number }

export function getStaticPaths() {
  return TRANSLATION_IDS.flatMap((translation) => {
    const seq = getBooks(translation).flatMap((book) =>
      getChapters(translation, book).map((chapter) => ({ book, chapter })),
    );
    return seq.map(({ book, chapter }, i) => ({
      params: { translation, book: book.slug, chapter: String(chapter.c) },
      props: {
        book,
        chapter,
        prev: i > 0 ? { book: seq[i - 1].book, c: seq[i - 1].chapter.c } : undefined,
        next: i < seq.length - 1 ? { book: seq[i + 1].book, c: seq[i + 1].chapter.c } : undefined,
      },
    }));
  });
}

const t = Astro.params.translation as TranslationId;
const { book, chapter, prev, next } = Astro.props as {
  book: Book;
  chapter: Chapter;
  prev?: Link;
  next?: Link;
};
const c = chapter.c;
const label = chapterLabel(book, c);
const verses = chapter.verses.filter((v) => v.t.trim());
const hrefs = Object.fromEntries(
  TRANSLATION_IDS.map((id) => [id, chapterHref(id, getBooks(id)[book.index], mapChapter(t, id, book, c))]),
) as Record<TranslationId, string>;
---
<Base title={`${label} (${TRANSLATIONS[t].label})`} description={`Read ${label} in the ${TRANSLATIONS[t].name}.`}>
  <article class="container reader">
    <div class="bar">
      <a class="back" href={bookHref(t, book)}>
        <CaretLeft width="18" height="18" aria-hidden="true" />{book.id === 'PSA' ? 'Psalms' : 'Chapters'}
      </a>
      <TranslationSwitch current={t} hrefs={hrefs} />
    </div>

    <h1>{book.id === 'PSA' ? 'Psalm' : book.name}<span class="visually-hidden"> {c}</span></h1>

    <div class="text">
      {verses.map((v, i) => (
        <p class="verse" id={`v${v.v}`}>
          {i === 0 && <span class="chapter-num" aria-hidden="true">{c}</span>}
          {(i > 0 || v.v !== '1') && <sup class="vn">{v.v}</sup>}
          {v.t}
        </p>
      ))}
    </div>

    <nav class="pager" aria-label="Chapters">
      {prev && (
        <a class="prev" href={chapterHref(t, prev.book, prev.c)}>
          <span class="rubric">Previous</span>
          <span class="where">{chapterLabel(prev.book, prev.c)}</span>
        </a>
      )}
      {next && (
        <a class="next" href={chapterHref(t, next.book, next.c)}>
          <span class="rubric">Next</span>
          <span class="where">{chapterLabel(next.book, next.c)}</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .reader {
    max-width: 38rem;
    padding-block: 1.25rem 0;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: clamp(1.75rem, 5vh, 3rem);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    font-size: var(--fs-h1);
    margin-bottom: 1.25rem;
  }

  .text {
    font-size: var(--fs-text);
    line-height: 1.7;
    hyphens: auto;
  }

  .verse {
    margin-bottom: 0.45em;
    padding-inline: 0.15em;
    border-radius: 2px;
    scroll-margin-top: 1.5rem;
  }

  .verse:target {
    background: var(--highlight);
  }

  /* Large chapter numeral at the start of the text, as in a printed Bible. */
  .chapter-num {
    float: left;
    margin: 0.04em 0.14em 0 0;
    color: var(--rubric);
    font-family: var(--font-display), Georgia, serif;
    font-size: 4.05em;
    font-weight: 600;
    line-height: 0.82;
    font-variant-numeric: lining-nums;
  }

  .vn {
    margin-right: 0.3em;
    color: var(--rubric);
    font-size: 0.62em;
    font-weight: 600;
    line-height: 0;
    vertical-align: 0.55em;
    font-variant-numeric: lining-nums;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }

  .pager .next {
    grid-column: 2;
    text-align: right;
  }

  .rubric {
    font-size: 0.9375rem;
  }

  .where {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .pager a:hover .where {
    color: var(--accent);
  }
</style>
