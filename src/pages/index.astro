---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getDailyVerses, dayIndex } from '../lib/votd';
import painting from '../assets/calling-of-saint-matthew.jpg';

const verses = getDailyVerses();
// Shown without JavaScript; the script below picks the visitor's own date.
const v = verses[dayIndex(new Date()) % verses.length];

const SECTIONS = [
  { label: 'Bible', href: '/bible/webc/', note: 'WEBC and Douay-Rheims' },
  { label: 'Library', href: '/library/', note: 'Coming soon' },
  { label: 'Chat', href: '/chat/', note: 'Coming soon' },
  { label: 'Trivia', href: '/trivia/', note: 'Coming soon' },
];
---
<Base bodyClass="home">
  <h1 class="visually-hidden">Rosario</h1>
  <section class="hero" aria-labelledby="votd-label">
    <Picture
      class="painting"
      src={painting}
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000, 2800]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
    />
    <div class="container copy">
      <p class="eyebrow reveal" id="votd-label">Verse of the day</p>
      <figure class="votd" id="votd" data-size={v.s}>
        <blockquote class="reveal">
          <p data-text>{v.t}</p>
        </blockquote>
        <figcaption class="reveal">
          <a class="ref" data-ref href={v.h}>{v.r}</a>
        </figcaption>
      </figure>
      <a class="cta reveal" href="/bible/webc/">Open the Bible</a>
    </div>
    <p class="credit container">Caravaggio, <i>The Calling of Saint Matthew</i>, 1599–1600</p>
  </section>
  <nav class="sections" aria-label="Sections">
    <ul class="container">
      {SECTIONS.map((s) => (
        <li>
          <a href={s.href}>
            <span class="name">{s.label}</span>
            <span class="note">{s.note}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <script is:inline type="application/json" id="votd-data" set:html={JSON.stringify(verses)} />
  <script>
    (() => {
      const list = JSON.parse(document.getElementById('votd-data').textContent);
      const d = new Date();
      const v = list[Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 864e5) % list.length];
      const box = document.getElementById('votd');
      box.dataset.size = v.s;
      box.querySelector('[data-text]').textContent = v.t;
      const ref = box.querySelector('[data-ref]');
      ref.textContent = v.r;
      ref.href = v.h;
    })();
  </script>
</Base>

<style>
  /* Header floats over the painting. */
  :global(body.home .site-header) {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    border-bottom: 0;
  }

  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    overflow: hidden;
  }

  .painting :global(img),
  .painting {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% 30%;
    filter: saturate(0.85) contrast(1.05);
  }

  /* Darken the bottom on phones, the left on wider screens, so the text reads. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, var(--paper) 0%, rgba(10, 11, 13, 0.92) 38%, rgba(10, 11, 13, 0.15) 70%, rgba(10, 11, 13, 0.45) 100%);
  }

  .copy {
    padding-block: 6rem 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .votd {
    margin: 0;
    max-width: 32rem;
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display), Georgia, serif;
    font-weight: 500;
    line-height: 1.15;
    text-wrap: pretty;
    color: var(--ink);
  }

  .votd[data-size='short'] blockquote {
    font-size: clamp(2.125rem, 1.5rem + 2.8vw, 3.5rem);
  }

  .votd[data-size='medium'] blockquote {
    font-size: clamp(1.875rem, 1.4rem + 2vw, 2.75rem);
  }

  .votd[data-size='long'] blockquote {
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.25rem);
  }

  figcaption {
    margin-top: 1rem;
  }

  .ref {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.25rem;
    font-style: italic;
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .ref:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  /* Crimson button in a thin gold frame. */
  .cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.95rem 2.25rem;
    background: linear-gradient(180deg, var(--crimson-hi), var(--crimson));
    border: 1px solid rgba(221, 162, 100, 0.35);
    outline: 1px solid rgba(145, 111, 87, 0.6);
    outline-offset: 3px;
    color: #f0e2cc;
    font-family: var(--font-display), Georgia, serif;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    transition: filter 0.2s ease;
  }

  .cta:hover {
    filter: brightness(1.15);
  }

  .cta:focus-visible {
    outline: 2px solid var(--accent);
  }

  .credit {
    margin: 0;
    padding-block: 0 1.25rem;
    text-align: right;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--muted);
  }

  .sections {
    border-block: 1px solid var(--rule);
    background: var(--paper);
  }

  .sections ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .sections li + li {
    border-left: 1px solid var(--rule);
  }

  .sections li:nth-child(3) {
    border-left: 0;
    border-top: 1px solid var(--rule);
  }

  .sections li:nth-child(4) {
    border-top: 1px solid var(--rule);
  }

  .sections a {
    display: grid;
    gap: 0.25rem;
    padding: 1.5rem 1.25rem;
    text-decoration: none;
    color: var(--ink);
  }

  .sections a:hover .name {
    color: var(--accent);
  }

  .name {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .note {
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .hero {
      justify-content: center;
    }

    .hero::after {
      background:
        linear-gradient(90deg, rgba(10, 11, 13, 0.95) 0%, rgba(10, 11, 13, 0.7) 32%, rgba(10, 11, 13, 0) 60%),
        linear-gradient(0deg, var(--paper) 0%, rgba(10, 11, 13, 0) 25%);
    }

    .copy {
      padding-block: 8rem 2rem;
    }

    .votd {
      max-width: 26rem;
    }

    .credit {
      position: absolute;
      inset: auto 0 0;
    }

    .sections ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .sections li:nth-child(n) {
      border-top: 0;
    }

    .sections li:nth-child(3) {
      border-left: 1px solid var(--rule);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      animation: rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 120ms);
    }

    /* Stagger set here, not in style attributes, so the CSP needs no 'unsafe-hashes'. */
    .eyebrow { --i: 0; }
    blockquote { --i: 1; }
    figcaption { --i: 2; }
    .cta { --i: 3; }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(0.6rem);
      }
    }
  }
</style>
