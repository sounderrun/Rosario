---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="container page">
    <h1>Page not found</h1>
    <p class="text">This address does not match any page on Rosario. Check the link, or start again from the Bible.</p>
    <a class="button" href="/bible/webc/">Read the Bible</a>
  </div>
</Base>

<style>
  .page {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 38rem;
    padding-block: clamp(2.5rem, 9vh, 6rem) 0;
  }

  h1 {
    font-size: var(--fs-h1);
  }

  .text {
    font-size: var(--fs-text);
    margin-bottom: 0.75rem;
  }
</style>
