---
/* A decade of ten beads in a teardrop loop, joined at a medal, with a pendant
   bead and a cross. Uses currentColor. public/favicon.svg draws the same shape. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
---
<svg
  class={className}
  width={(size * 24) / 32}
  height={size}
  viewBox="0 0 24 32"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="15.07" cy="14.15" r="1.45" />
  <circle cx="16.83" cy="10.97" r="1.45" />
  <circle cx="17.69" cy="7.47" r="1.45" />
  <circle cx="16.74" cy="4.03" r="1.45" />
  <circle cx="13.78" cy="2.04" r="1.45" />
  <circle cx="10.2" cy="2.05" r="1.45" />
  <circle cx="7.25" cy="4.05" r="1.45" />
  <circle cx="6.31" cy="7.49" r="1.45" />
  <circle cx="7.18" cy="10.99" r="1.45" />
  <circle cx="8.95" cy="14.18" r="1.45" />
  <path d="M8.95 14.18 12 16.4l3.07-2.25M12 20v4.6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.6" />
  <path d="M12 16.4 13.5 18.2 12 20 10.5 18.2Z" />
  <circle cx="12" cy="22.4" r="1.3" />
  <path d="M12 24.6v6.7M9.5 26.8h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
</svg>
