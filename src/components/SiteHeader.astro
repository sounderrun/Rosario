---
import RosaryMark from './RosaryMark.astro';
import { NAV, currentFor } from '../lib/nav';

const { pathname } = Astro.url;
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-current={pathname === '/' ? 'page' : undefined}>
      <RosaryMark class="mark" size={30} />
      <span class="wordmark">Rosario</span>
    </a>
    <nav class="top-nav" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={currentFor(pathname, item)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }

  .mark {
    color: var(--rubric);
    flex: none;
  }

  .wordmark {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    padding-bottom: 0.1em;
  }

  .top-nav {
    display: none;
  }

  @media (min-width: 48rem) {
    .bar {
      min-height: 4.5rem;
    }

    .top-nav {
      display: block;
    }

    .top-nav ul {
      display: flex;
      gap: clamp(1.25rem, 3vw, 2.25rem);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .top-nav a {
      display: inline-block;
      padding-block: 0.5rem;
      color: var(--ink-soft);
      font-size: 0.8125rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      text-decoration: none;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.45em;
    }

    .top-nav a:hover {
      color: var(--accent);
    }

    .top-nav a[aria-current] {
      color: var(--accent);
      text-decoration-line: underline;
      text-decoration-color: var(--gold);
    }
  }
</style>
