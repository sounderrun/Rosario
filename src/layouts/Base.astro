---
import Header from '../components/Header.astro';

interface Props {
  title?: string;
}
const { title = 'Rosario' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fbfaf7;
    --fg: #1c1b19;
    --muted: #5c5a55;
    --line: #e4e1da;
    --hover: #efece5;
    --accent: #1e3a8a;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141413;
      --fg: #ecebe7;
      --muted: #a6a39b;
      --line: #2c2b28;
      --hover: #22211f;
      --accent: #d4a73c;
    }
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, sans-serif;
  }
  main {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
</style>
